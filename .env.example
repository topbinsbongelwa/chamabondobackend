# Local port. Vercel sets PORT automatically.
PORT=5000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local: http://localhost:5173
# Vercel: https://chamasattendance-sys.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. MONGO_URI is also accepted.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/chamabondo
MONGO_URI=

# Database name (defaults to chamabondo).
MONGODB_DB=chamabondo

# JWT signing secret and lifetime.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800

# File storage: use cloudinary in production. Local files are ephemeral on Vercel.
STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=schemebooks

# Attendance timing.
ATTENDANCE_LATE_AFTER=08:00
MORNING_LATE_AFTER=08:00
AFTERNOON_LATE_AFTER=13:00

# Long-running cron jobs (disabled automatically on Vercel).
AUTO_ABSENT=false

# Intelli AI providers (optional).
INTELLI_AI_URL=http://localhost:5055
INTELLI_AI_KEY=replace-with-your-intelli-ai-api-key
INTELLI_AI_SYSTEM_PROMPT=You are an education assistant. Provide accurate, age-appropriate teaching support.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
FREE_DAILY_LIMIT=10
AI_RATE_LIMIT=60
AI_HISTORY_LIMIT=20
MOCK_INTELLI_AI_PORT=5055

# Optional browser push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
